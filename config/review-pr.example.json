{
  "$schema": "./review-pr.schema.json",
  "agents": {
    "claude": {
      "label": "Claude",
      "type": "claude",
      "enabled": true,
      "model": "claude-opus-5",
      "effort": "high",
      "timeout_seconds": 0
    },
    "codex": {
      "label": "Codex",
      "type": "codex",
      "enabled": true,
      "model": "gpt-5.6-terra",
      "effort": "high",
      "timeout_seconds": 0
    }
  },
  "reviewers": [
    "claude",
    "codex"
  ],
  "synthesizer": "codex",
  "default_repository": "repository",
  "repositories": {
    "repository": {
      "github": "owner/repository",
      "checkout": "/absolute/path/to/dedicated/review-checkout",
      "profile": "default"
    }
  },
  "profiles": {
    "default": {
      "skills": {}
    }
  },
  "reviews_directory": "/absolute/path/to/review-pr-output",
  "language": "EN",
  "finalization": {
    "model": "",
    "effort": ""
  },
  "reporting": {
    "finding_contract": {
      "primary": "ndjson-v1",
      "cross_review": "ndjson-v1",
      "final": "ndjson-v1"
    },
    "comparison_sections": {
      "cross_review": "none",
      "final": "standalone"
    }
  },
  "status": {
    "mode": "auto",
    "color": "auto",
    "refresh_interval_seconds": 1,
    "log_interval_seconds": 30,
    "show_pid": true
  },
  "execution": {
    "max_concurrency": 3,
    "retry": {
      "max_attempts": 2,
      "delay_seconds": 5
    }
  }
}
