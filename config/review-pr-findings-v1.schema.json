{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-pr.dev/schema/findings-record-v1.json",
  "title": "review-pr ndjson-v1 record",
  "oneOf": [
    {
      "$ref": "#/$defs/finding"
    },
    {
      "$ref": "#/$defs/resolution"
    },
    {
      "$ref": "#/$defs/complete"
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "start", "end"],
      "properties": {
        "kind": {
          "enum": ["changed-line", "pr-level"]
        },
        "file": {
          "type": ["string", "null"]
        },
        "start": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "end": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "changed-line"
              }
            }
          },
          "then": {
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "file": {
                "const": null
              },
              "start": {
                "const": null
              },
              "end": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "existingFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "thread_ids"],
      "properties": {
        "state": {
          "enum": ["new", "confirmed-existing", "historical", "unknown"]
        },
        "thread_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {"const": "new"}
            }
          },
          "then": {
            "properties": {
              "thread_ids": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {"enum": ["confirmed-existing", "historical"]}
            }
          },
          "then": {
            "properties": {
              "thread_ids": {"minItems": 1}
            }
          }
        }
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "source_id"],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "schema_version",
        "source_id",
        "title",
        "claim",
        "anchor",
        "evidence",
        "failure_scenario",
        "recommendation",
        "classification",
        "severity",
        "category",
        "contributing_agents",
        "verification_limitations",
        "existing_feedback"
      ],
      "properties": {
        "record": {
          "const": "finding"
        },
        "schema_version": {
          "const": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_scenario": {
          "type": ["string", "null"],
          "description": "Non-empty for unclassified primary and CONFIRMED records; may be null or empty for REJECTED and UNCERTAIN records."
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": ["string", "null"],
          "enum": ["CONFIRMED", "REJECTED", "UNCERTAIN", null]
        },
        "severity": {
          "type": ["string", "null"],
          "enum": ["P0", "P1", "P2", "P3", null]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "contributing_agents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_limitations": {
          "$ref": "#/$defs/stringArray"
        },
        "existing_feedback": {
          "$ref": "#/$defs/existingFeedback"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "include_in_rejected_summary": {
          "type": "boolean",
          "description": "Final-synthesis-only decision to surface an important rejected claim in the human report."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {"enum": ["CONFIRMED", null]}
            }
          },
          "then": {
            "properties": {
              "failure_scenario": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opt-in final-synthesis record (reporting.dispute_resolution) that settles one cross-review dispute detected by the orchestrator.",
      "required": [
        "record",
        "schema_version",
        "dispute_id",
        "primary_ref",
        "conflicting_refs",
        "final_source_id",
        "dispute_kind",
        "resolution_status",
        "verification_method",
        "command",
        "observed",
        "basis",
        "basis_source",
        "limitations"
      ],
      "properties": {
        "record": {
          "const": "resolution"
        },
        "schema_version": {
          "const": 1
        },
        "dispute_id": {
          "type": "string",
          "pattern": "^dispute:[A-Za-z0-9][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "primary_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "conflicting_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "final_source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "dispute_kind": {
          "enum": ["factual", "severity", "mixed"]
        },
        "resolution_status": {
          "enum": ["resolved", "uncertain", "not_applicable"]
        },
        "verification_method": {
          "enum": ["source", "command", "test", "repository_rule", "runtime", "manual"]
        },
        "command": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Declarative argv array of the measurement. Recorded, never evaluated as a shell string."
        },
        "observed": {
          "type": "string"
        },
        "basis": {
          "enum": ["explicit_repository_rule", "skill_rule", "inferred_convention", "general_engineering"]
        },
        "basis_source": {
          "type": ["string", "null"]
        },
        "limitations": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "schema_version",
        "finding_count",
        "summary",
        "verification_limitations",
        "positive_evidence"
      ],
      "properties": {
        "record": {
          "const": "complete"
        },
        "schema_version": {
          "const": 1
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "verification_limitations": {
          "$ref": "#/$defs/stringArray"
        },
        "positive_evidence": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
